use valk.json
use valk.time

@ignore_access

// Starts the text of a date `value_from` makes, which `encode` writes without quotes. No text a
// program writes starts with it.
value DATE_MARK ("\x00toml date\x00")

// `value` as `T`; a value that does not fit throws `.type` naming the key at `path`
fn value_to[T](value: json.Value, path: String) T !Error {
    #if T.$is_nullable
    if value.is_null : return null
    return value_to[T.$nonnull](value, path) !>
    #elif T.$is_type_of(time.DateTime)
    let text = value.is_string ? value.string : ""
    return parse_datetime(text) ?! throw .type { message: "'" + path + "' should be a date, or a date and time" }
    #elif T.$has_method(from_toml_value)
    return T.from_toml_value(value, path) !>
    #elif T.$is_type_of(json.Value) || T.$is_type_of(String) || T.$is_integer || T.$is_float || T.$is_bool || T.$has_method(from_json_value) || T.$has_method(from_json_value_auto) || !T.$is_structural
    return value.to_type[T]() ! throw .type { message: "'" + path + "' should be " + expected_kind[T]() }
    #else
    if !value.is_object : throw .type { message: "'" + path + "' should be a table" }
    let source = value.object
    let result = T {
        #loop properties T as prop
        prop: <{
            #if prop.$tag("toml") == "-"
            #if prop.$has_default_value
            return prop.$default_value
            #else
            #error "Skipped TOML property has no default value"
            #end
            #else
            let name = prop.$tag("toml", prop.name)
            let key = path.is_empty() ? name : path + "." + name
            #if prop.$has_explicit_default_value || prop.$type.$is_nullable || (prop.$has_tag("omitempty") && prop.$has_default_value)
            let field = source.get(name) ! return prop.$default_value
            if field.is_null : return prop.$default_value
            return value_to[prop](field, key) !>
            #else
            let field = source.get(name) ! throw .type { message: "'" + key + "' is missing" }
            return value_to[prop](field, key) !>
            #end
            #end
        }
        #end
    }
    return result
    #end
}

fn is_empty_value(data: $T) bool {
    #if T.$is_nullable
    if !isset(data) : return true
    return is_empty_value(data)
    #elif T.$is_type_of(json.Value)
    if data.is_null : return true
    if data.is_string : return data.string.bytes == 0
    if data.is_array : return data.array.length == 0
    if data.is_object : return data.object.length == 0
    if data.is_bool : return !data.bool
    if data.is_int : return data.int == 0
    if data.is_float : return data.float == 0.0
    return false
    #elif T.$is_type_of(String)
    return data.bytes == 0
    #elif T.$has_method(is_json_empty)
    return data.is_json_empty()
    #elif T.$is_bool
    return !data
    #elif T.$is_integer
    #if T.$is_signed
    return data.to(int) == 0
    #else
    return data.to(uint) == 0
    #end
    #elif T.$is_float
    return data == 0.0
    #else
    return false
    #end
}

// `data` as a JSON value, as `json.from` makes it, with its dates marked for `encode`. `stack`
// holds the objects being written, so one that holds itself becomes "(recursion)" as there.
fn value_from(data: $T, stack: Array[uint]) json.Value {
    #if T.$is_nullable
    if !isset(data) : return null
    return value_from(data, stack)
    #elif T.$is_type_of(time.DateTime)
    return json.new_string(DATE_MARK + data.to_iso8601())
    #elif T.$has_method(to_toml_value)
    return data.to_toml_value(stack)
    #elif T.$has_method(to_json_string)
    return json.new_string(data.to_json_string())
    #elif T.$is_type_of(json.Value) || T.$is_type_of(String) || T.$is_integer || T.$is_float || T.$is_bool || T.$has_method(to_json_value) || T.$has_method(to_json_value_with_stack) || !T.$is_structural
    return json.from(data)
    #else
    #if T.$is_pointer
    @unsafe
    let node = data.@cast(ptr).@cast(uint)
    if stack.contains(node) : return json.new_string("(recursion)")
    stack.append(node)
    #end
    let values = Map[json.Value]{}
    #loop object data as prop
    #if prop.$tag("toml") != "-"
    #if prop.$has_tag("omitempty")
    if !is_empty_value(prop) {
        values.set(prop.$tag("toml", prop.name), value_from(prop, stack))
    }
    #else
    values.set(prop.$tag("toml", prop.name), value_from(prop, stack))
    #end
    #end
    #end
    #if T.$is_pointer
    stack.pop_last() _
    #end
    return json.new_object(values)
    #end
}

extend Array[TOML_ITEM] {
    - fn to_toml_value(stack: Array[uint]) json.Value {
        #if TOML_ITEM.$is_raw_pointer
        @unsafe
        #end
        let result = Array[json.Value]{}
        each this as item {
            result.append(value_from(item, stack))
        }
        return json.new_array(result)
    }

    - static fn from_toml_value(value: json.Value, path: String) SELF !Error {
        if !value.is_array : throw .type { message: "'" + path + "' should be an array" }
        let result = SELF.new()
        each value.array as item, index {
            result.append(value_to[TOML_ITEM](item, path + "[" + index + "]") !>)
        }
        return result
    }
}

extend HashMap[TOML_KEY, TOML_VALUE] {
    #if TOML_KEY.$is_type_of(String)
    - fn to_toml_value(stack: Array[uint]) json.Value {
        let result = Map[json.Value]{}
        each this as item, key {
            result.set(key, value_from(item, stack))
        }
        return json.new_object(result)
    }

    - static fn from_toml_value(value: json.Value, path: String) SELF !Error {
        if !value.is_object : throw .type { message: "'" + path + "' should be a table" }
        let result = SELF.new()
        each value.object as item, key {
            let item_path = path.is_empty() ? key : path + "." + key
            result.set(key, value_to[TOML_VALUE](item, item_path) !>)
        }
        return result
    }
    #elif TOML_KEY.$is_integer && !TOML_KEY.$is_enum
    - fn to_toml_value(stack: Array[uint]) json.Value {
        let result = Map[json.Value]{}
        each this as item, key {
            result.set(key.to_string(), value_from(item, stack))
        }
        return json.new_object(result)
    }

    - static fn from_toml_value(value: json.Value, path: String) SELF !Error {
        if !value.is_object : throw .type { message: "'" + path + "' should be a table" }
        let result = SELF.new()
        each value.object as item, key {
            let item_path = path.is_empty() ? key : path + "." + key
            let number = key.to(TOML_KEY) ! throw .type { message: "'" + item_path + "' should have an integer key" }
            result.set(number, value_to[TOML_VALUE](item, item_path) !>)
        }
        return result
    }
    #end
}

extend FlatMap[TOML_FLAT_KEY, TOML_FLAT_VALUE] {
    #if TOML_FLAT_KEY.$is_type_of(String)
    - fn to_toml_value(stack: Array[uint]) json.Value {
        let result = Map[json.Value]{}
        each this as item, key {
            result.set(key, value_from(item, stack))
        }
        return json.new_object(result)
    }

    - static fn from_toml_value(value: json.Value, path: String) SELF !Error {
        if !value.is_object : throw .type { message: "'" + path + "' should be a table" }
        let result = SELF.new()
        each value.object as item, key {
            let item_path = path.is_empty() ? key : path + "." + key
            result.set(key, value_to[TOML_FLAT_VALUE](item, item_path) !>)
        }
        return result
    }
    #end
}

extend HashSet[TOML_SET_ITEM] {
    - fn to_toml_value(stack: Array[uint]) json.Value {
        let result = Array[json.Value]{}
        each this as item {
            result.append(value_from(item, stack))
        }
        return json.new_array(result)
    }

    - static fn from_toml_value(value: json.Value, path: String) SELF !Error {
        if !value.is_array : throw .type { message: "'" + path + "' should be an array" }
        let result = SELF.new()
        each value.array as item, index {
            result.add(value_to[TOML_SET_ITEM](item, path + "[" + index + "]") !>)
        }
        return result
    }
}

extend Deque[TOML_DEQUE_ITEM] {
    - fn to_toml_value(stack: Array[uint]) json.Value {
        let result = Array[json.Value]{}
        each this as item {
            result.append(value_from(item, stack))
        }
        return json.new_array(result)
    }

    - static fn from_toml_value(value: json.Value, path: String) SELF !Error {
        if !value.is_array : throw .type { message: "'" + path + "' should be an array" }
        let result = SELF.new()
        each value.array as item, index {
            result.push_back(value_to[TOML_DEQUE_ITEM](item, path + "[" + index + "]") !>)
        }
        return result
    }
}

// A TOML date or date and time: one with an offset is converted to UTC, one without is taken as
// UTC, and a date alone is its midnight. Null for anything else, a time of day included.
fn parse_datetime(text: String) ?time.DateTime {
    if text.length < 10 || text[4] != '-' || text[7] != '-' : return null
    let year = read_digits(text, 0, 4) ?! return null
    let month = read_digits(text, 5, 2) ?! return null
    let day = read_digits(text, 8, 2) ?! return null
    if text.length == 10 : return time.DateTime.new(year.to(int), month, day) !? null
    let separator = text[10]
    if separator != 'T' && separator != 't' && separator != ' ' : return null
    if text.length < 16 || text[13] != ':' : return null
    let hour = read_digits(text, 11, 2) ?! return null
    let minute = read_digits(text, 14, 2) ?! return null
    let second: uint = 0
    let microsecond: uint = 0
    let i: uint = 16
    // TOML 1.1 lets the seconds be left out
    if i < text.length && text[i] == ':' {
        second = read_digits(text, 17, 2) ?! return null
        i = 19
        if i < text.length && text[i] == '.' {
            i++
            let digits: uint = 0
            while i < text.length && text[i] >= '0' && text[i] <= '9' {
                // Microseconds keep six digits; more are cut off
                if digits < 6 {
                    microsecond = microsecond * 10 + (text[i] - '0').to(uint)
                    digits++
                }
                i++
            }
            if digits == 0 : return null
            while digits < 6 {
                microsecond = microsecond * 10
                digits++
            }
        }
    }
    let offset: int = 0
    if i < text.length && (text[i] == 'Z' || text[i] == 'z') {
        i++
    } else if i < text.length && (text[i] == '+' || text[i] == '-') {
        if i + 6 != text.length || text[i + 3] != ':' : return null
        let hours = read_digits(text, i + 1, 2) ?! return null
        let minutes = read_digits(text, i + 4, 2) ?! return null
        offset = (hours * 60 + minutes).to(int)
        if text[i] == '-' : offset = 0 - offset
        i += 6
    }
    if i != text.length : return null
    let local = time.DateTime.new(year.to(int), month, day, hour, minute, second, microsecond) !? null
    if !isset(local) : return null
    if offset == 0 : return local
    return local.add_minutes(0 - offset) !? null
}

// The number written with exactly `count` digits at `at`
fn read_digits(text: String, at: uint, count: uint) ?uint {
    if at + count > text.length : return null
    let value: uint = 0
    let i: uint = 0
    while i < count {
        let ch = text[at + i]
        if ch < '0' || ch > '9' : return null
        value = value * 10 + (ch - '0').to(uint)
        i++
    }
    return value
}

fn expected_kind[T]() String {
    #if T.$nonnull.$is_type_of(String)
    return "a string"
    #elif T.$is_integer
    return "an integer that fits the field"
    #elif T.$is_float
    return "a number"
    #elif T.$is_bool
    return "true or false"
    #else
    return "a value of the field's type"
    #end
}
