// The cursor over the text: bytes, lines and columns, and the small reads every part needs.
class Reader {
    text: String
    at: uint (0)
    line: uint (1)
    column: uint (1)
    // What made each table, by its address
    kinds: HashMap[uint, Kind] (.{})
    // How many arrays and inline tables the reader is inside
    depth: uint (0)

    fn done() bool {
        return this.at >= this.text.length
    }
    fn peek() u8 {
        if this.done() : return 0
        return this.text[this.at]
    }
    fn peek_at(ahead: uint) u8 {
        let index = this.at + ahead
        if index >= this.text.length : return 0
        return this.text[index]
    }
    fn next() u8 {
        if this.done() : return 0
        let ch = this.text[this.at++]
        if ch == '\n' {
            this.line++
            this.column = 1
        } else {
            this.column++
        }
        return ch
    }
    fn skip(amount: uint) {
        let i: uint = 0
        while i++ < amount : this.next()
    }
    fn starts_with(part: String) bool {
        if this.at + part.length > this.text.length : return false
        let i: uint = 0
        while i < part.length {
            if this.text[this.at + i] != part[i] : return false
            i++
        }
        return true
    }

    // Spaces and tabs, but not the end of a line: TOML cares where a line ends
    fn skip_spaces() {
        while !this.done() {
            let ch = this.peek()
            if ch == ' ' || ch == '\t' : this.next()
            else : break
        }
    }
    // Everything that may sit between two values: spaces, comments and line ends
    fn skip_space_and_lines() !Error {
        while !this.done() {
            let ch = this.peek()
            if ch == ' ' || ch == '\t' || ch == '\n' {
                this.next()
                continue
            }
            if ch == '\r' {
                if this.peek_at(1) != '\n' : this.fail("A carriage return must be followed by a line feed")
                this.next()
                continue
            }
            if ch == '#' {
                this.skip_comment() !>
                continue
            }
            break
        }
    }
    // A comment up to the end of its line, which may not hold control characters
    fn skip_comment() !Error {
        while !this.done() {
            let ch = this.peek()
            if ch == '\n' || (ch == '\r' && this.peek_at(1) == '\n') : break
            if is_control(ch) : this.fail("A comment may not hold control characters")
            this.next()
        }
    }
    // The rest of a line after a value: spaces, a comment, then the line must end
    fn end_of_line() !Error {
        this.skip_spaces()
        if this.peek() == '#' : this.skip_comment() !>
        if this.done() : return
        let ch = this.peek()
        if ch == '\n' {
            this.next()
            return
        }
        if ch == '\r' && this.peek_at(1) == '\n' {
            this.skip(2)
            return
        }
        this.fail("Expected the end of the line, found '" + ch.to_ascii_string() + "'")
    }

    fn fail(message: String) !Error $throw {
        throw .syntax { message: message, line: this.line, column: this.column }
    }
    fn fail_duplicate(message: String) !Error $throw {
        throw .duplicate { message: message, line: this.line, column: this.column }
    }
}

// Control characters other than tab, which TOML does not allow in strings or comments
fn is_control(ch: u8) bool {
    return (ch < 0x20 && ch != '\t') || ch == 0x7f
}
