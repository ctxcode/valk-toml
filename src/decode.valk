use valk.json

/// Reads TOML and returns it as a `json.Value`, so everything that works with JSON works with it.
///
/// Dates and times come through as the text they were written as; TOML has types for them and
/// JSON does not. `decode_to` reads them into `time.DateTime` fields.
///
/// ```valk
/// let config = toml.decode(fs.read("config.toml") !!) ! panic("%{E.message}")
/// println(config["server"]["port"].int)
/// ```
+ fn decode(text: String) json.Value !Error {
    let r = Reader { text: text }
    check_utf8(r) !>
    let root = json.new_object()
    r.kinds.set(node_id(root), Kind.header)
    // The table the keys that follow are written into
    let current = root

    while true {
        r.skip_space_and_lines() !>
        if r.done() : break

        if r.peek() == '[' {
            let is_array = r.peek_at(1) == '['
            let path = read_table_header(r, is_array) !>
            r.end_of_line() !>
            if is_array : current = open_array_table(r, root, path) !>
            else : current = open_table(r, root, path) !>
            continue
        }

        let key = read_key_path(r) !>
        r.skip_spaces()
        if r.next() != '=' : r.fail("Expected '=' after a key")
        r.skip_spaces()
        let value = read_value(r) !>
        r.end_of_line() !>
        set_key(r, current, key, value) !>
    }
    let document: json.Value = root
    return document
}

/// Reads TOML into a class or struct of your own.
///
/// Every field must be in the text, unless it is nullable or has a default. A value that does
/// not fit throws `.type`, and its message names the key, such as `'server.port' is missing`;
/// `line` and `column` are only set for syntax errors. A `time.DateTime` field takes a date, or a
/// date and time, converted to UTC.
///
/// ```valk
/// class Settings {
///     name: String
///     port: uint (8080)
/// }
///
/// let settings = toml.decode_to[Settings](text) ! panic("%{E.message}")
/// ```
+ fn decode_to[T](text: String) T !Error {
    let document = decode(text) !>
    return value_to[T](document, "") !>
}

// `[a.b]` or `[[a.b]]`
fn read_table_header(r: Reader, is_array: bool) Array[String] !Error {
    r.next() // `[`
    if is_array : r.next()
    r.skip_spaces()
    let path = read_key_path(r) !>
    r.skip_spaces()
    if r.next() != ']' : r.fail("Expected ']' after a table name")
    if is_array && r.next() != ']' : r.fail("Expected ']]' after the name of an array table")
    return path
}

// `a`, `a.b`, `"a b".c`
fn read_key_path(r: Reader) Array[String] !Error {
    let path = Array[String]{}
    while true {
        r.skip_spaces()
        let ch = r.peek()
        if ch == '"' || ch == '\'' {
            if r.starts_with("\"\"\"") || r.starts_with("'''") : r.fail("A key cannot be a multi-line string")
            path.append(read_string(r) !>)
        } else {
            let out = ByteBuffer.new(16)
            while !r.done() {
                let c = r.peek()
                if is_bare_key_byte(c) {
                    out.write_byte(r.next())
                    continue
                }
                break
            }
            if out.length == 0 : r.fail("Expected a key")
            path.append(out.to_string())
        }
        r.skip_spaces()
        if r.peek() == '.' {
            r.next()
            continue
        }
        return path
    }
}

fn is_bare_key_byte(ch: u8) bool {
    if ch >= 'a' && ch <= 'z' : return true
    if ch >= 'A' && ch <= 'Z' : return true
    if ch >= '0' && ch <= '9' : return true
    return ch == '_' || ch == '-'
}

// TOML text is UTF-8; anything else is refused before it is read
fn check_utf8(r: Reader) !Error {
    let text = r.text
    let i: uint = 0
    while i < text.length {
        let ch = text[i]
        if ch < 0x80 {
            i++
            continue
        }
        let size: uint = 0
        let low: u8 = 0x80
        let high: u8 = 0xbf
        if ch >= 0xc2 && ch <= 0xdf : size = 2
        else if ch >= 0xe0 && ch <= 0xef {
            size = 3
            if ch == 0xe0 : low = 0xa0
            if ch == 0xed : high = 0x9f
        } else if ch >= 0xf0 && ch <= 0xf4 {
            size = 4
            if ch == 0xf0 : low = 0x90
            if ch == 0xf4 : high = 0x8f
        }
        let ok = size > 0 && i + size <= text.length
        if ok {
            let second = text[i + 1]
            if second < low || second > high : ok = false
            let k: uint = 2
            while ok && k < size {
                let next = text[i + k]
                if next < 0x80 || next > 0xbf : ok = false
                k++
            }
        }
        if !ok {
            r.skip(i)
            r.fail("The text is not valid UTF-8")
        }
        i += size
    }
}
